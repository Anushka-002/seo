# LLM provider: groq | gemini
LLM_PROVIDER=groq
GROQ_API_KEY=
GEMINI_API_KEY=
# SERP provider: leave SERPER_API_KEY empty to fall back to DuckDuckGo
SERPER_API_KEY=
# App
DATABASE_URL=sqlite:///./data/seoul.db
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_HOUR=10
LOG_LEVEL=INFO
# Embeddings: sbert (all-MiniLM-L6-v2, local) | hashing (offline fallback for tests)
EMBEDDER=sbert
# Model names (override if a provider retires one)
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_MODEL=gemini-2.0-flash
MAX_CONCURRENT_ANALYSES=2
TRUSTED_PROXY_HOPS=1
BLOCK_PRIVATE_HOSTS=true
